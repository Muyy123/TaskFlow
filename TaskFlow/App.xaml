<Application x:Class="TaskFlow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TaskFlow.Converters">
    <!-- 注意：这里不设置 StartupUri，主窗口由 App.xaml.cs 通过 DI 容器解析并手动 Show。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 后续在此合并主题资源：
                     Themes/Light.xaml 与 Themes/Dark.xaml 由 ThemeService 在运行时动态切换。 -->
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局转换器：枚举 → 中文（任务列表、任务对话框都会用到） -->
            <converters:EnumToChineseConverter x:Key="EnumToChinese"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
