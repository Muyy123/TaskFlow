<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FF2B3A4A"/> <!--顶部工具栏背景-->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF3A4A5C"/> <!--左侧导航背景-->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFF4F6F8"/> <!--内容区背景-->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/> <!--卡片/面板/表格底-->
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFFFF"/> <!--深色背景上的文字-->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF333333"/> <!--主文字-->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFFFFFFF"/> <!--次要文字-->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF808080"/> <!--分页控件的高亮色）-->
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD9D9D9"/> <!--边框/分割线-->
</ResourceDictionary>