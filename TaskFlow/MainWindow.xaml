<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TaskFlow.ViewModels"
        xmlns:pages="clr-namespace:TaskFlow.ViewModels.Pages"
        xmlns:views="clr-namespace:TaskFlow.Views"
        mc:Ignorable="d"
        Title="TaskFlow"
        Height="720" Width="1200"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <!-- ViewModel → 视图 的映射：骨架阶段用占位 TextBlock，后续替换为真实的 UserControl。
             例如 <DataTemplate DataType="{x:Type pages:DashboardViewModel}"><views:DashboardView/></DataTemplate> -->
        <DataTemplate DataType="{x:Type pages:DashboardViewModel}">
            <TextBlock Text="{Binding Title}" FontSize="24" Foreground="#FF333333"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:ProjectsViewModel}">
            <TextBlock Text="{Binding Title}" FontSize="24" Foreground="#FF333333"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:TaskListViewModel}">
            <views:TaskListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsViewModel}">
            <TextBlock Text="{Binding Title}" FontSize="24" Foreground="#FF333333"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 顶部工具栏 ══════════ -->
        <Border Grid.Row="0" Background="#FF2B3A4A">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="TaskFlow"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <!-- 右侧：主题切换按钮占位（后续绑定 SettingsViewModel 的主题切换命令） -->
                <TextBlock DockPanel.Dock="Right"
                           Text="主题"
                           Foreground="White" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════ 左侧导航栏 ══════════ -->
            <Border Grid.Column="0" Background="#FF3A4A5C">
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       Padding="16,12"
                                       Foreground="White"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <!-- 选中态高亮等完整样式会在 Themes 阶段统一实现 -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- ══════════ 内容区 ══════════ -->
            <Border Grid.Column="1" Background="#FFF4F6F8">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
