<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TaskFlow.Controls">

    <!-- PaginationControl 的默认样式（由 ThemeInfo 定位到此文件） -->
    <Style TargetType="{x:Type controls:PaginationControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PaginationControl}">
                    <StackPanel Orientation="Horizontal">

                        <!-- 上一页 -->
                        <Button Content="上一页"
                                Padding="10,4" Margin="0,0,4,0"
                                Command="{TemplateBinding GoToPageCommand}"
                                CommandParameter="{TemplateBinding PreviousPage}"
                                IsEnabled="{TemplateBinding IsPreviousEnabled}"/>

                        <!-- 页码按钮 -->
                        <ItemsControl ItemsSource="{TemplateBinding PageNumbers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button MinWidth="30" Margin="2,0"
                                            Content="{Binding Number}"
                                            Command="{Binding GoToPageCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:PaginationControl}}}"
                                            CommandParameter="{Binding Number}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <!-- 当前页高亮 -->
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 下一页 -->
                        <Button Content="下一页"
                                Padding="10,4" Margin="4,0,0,0"
                                Command="{TemplateBinding GoToPageCommand}"
                                CommandParameter="{TemplateBinding NextPage}"
                                IsEnabled="{TemplateBinding IsNextEnabled}"/>

                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
