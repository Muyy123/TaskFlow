<UserControl x:Class="TaskFlow.Views.ProjectsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:vm="clr-namespace:TaskFlow.ViewModels.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance Type=vm:ProjectsViewModel}">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--第0行：搜索/筛选工具栏-->
            <RowDefinition Height="Auto"/>
            <!--第1行：加载进度条-->
            <RowDefinition Height="*"/>
            <!--第2行：表格+空状态，占满剩余高度-->
        </Grid.RowDefinitions>

        <!--第0行：搜索+筛选+新建-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!--新建按钮按内容自适应-->
                <ColumnDefinition Width="*"/>  <!--搜索框占满剩余宽度-->
                <ColumnDefinition Width="Auto"/> <!--复选框按内容自适应-->
                <ColumnDefinition Width="Auto"/> <!--按钮按内容自适应-->
                <ColumnDefinition Width="Auto"/> <!--删除按钮按内容自适应-->
            </Grid.ColumnDefinitions>

            <!--新建项目按钮：绑定AddProjectCommand，点击打开新建对话框-->
            <Button Grid.Column="0"
                    Content="新建项目"
                    Command="{Binding AddProjectCommand}"
                    Padding="16,5"
                    Margin="0,0,8,0"/>

            <!--搜索输入框 UpdateSourceTrigger=PropertyChanged: 每敲一个字就立即更新SearchText-->
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" VerticalContentAlignment="Center"/>

            <!--筛选复选框：仅显示有任务的项目 
            IsChecked 双向绑定 HasTasks，勾选变化会触发 OnHasTasksChanged 重新加载o-->
            <CheckBox Grid.Column="2"
                      Content="仅显示有任务"
                      IsChecked="{Binding HasTasks}"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!--搜索按钮, 绑定ViewModel里的SearchCommand命令，点击触发重新加载项目列表-->
            <Button Grid.Column="3"
                    Content="搜索"
                    Command="{Binding SearchCommand}"
                    Padding="16,5"
                    Margin="8,0,0,0"/>
            <!--删除按钮：绑定 DeleteProjectCommand，没选中项目时 Command 的 CanExecute 返回 false，按钮自动禁用-->
            <Button Grid.Column="4"
                    Content="删除选择"
                    Command="{Binding DeleteProjectCommand}"
                    Padding="16, 5"
                    Margin="8,0,0,0"/>
        </Grid>
        <!--第1行：加载进度条（Isloading为true是滚动）-->
        <ProgressBar Grid.Row="1" Height="3" Margin="0,8"
                     IsIndeterminate="{Binding IsLoading}"/>

        <!--第2行；表格+空状态提示-->
        <Grid Grid.Row="2">
            <!--项目列表表格-->
            <DataGrid ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <!--颜色列: 模板列，用来展示项目的颜色块-->
                    <DataGridTemplateColumn Header="颜色" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 矩形色块，Fill绑定项目Color属性，WPF自动把色值字符串转Brush -->
                                <Rectangle Width="16" Height="16" RadiusX="2" RadiusY="2"
                           Fill="{Binding Color}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="2*"/>
                    <!-- 任务数量：依赖服务层Include(p=>p.Tasks)预加载，否则访问不到Tasks集合 -->
                    <DataGridTextColumn Header="任务数" Binding="{Binding Tasks.Count}" Width="80"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- 空状态提示：当列表没有数据时显示【暂无项目】 -->
            <TextBlock Text="暂无项目" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!--默认状态：隐藏-->
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- 当ViewModel的IsEmpty = true时，显示提示文字 -->
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
