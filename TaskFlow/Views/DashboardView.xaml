<UserControl x:Class="TaskFlow.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskFlow.ViewModels.Pages"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--加载进度条-->
        <ProgressBar Grid.Row="0" Height="3" Margin="0,0,0,16"
                     IsIndeterminate="{Binding IsLoading}"/>
        
        <!--KPI卡片区：4张卡片横向排开-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--①总任务卡片-->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Margin="0,0,12,0" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="总任务" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                    <TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <!--②待办卡片-->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Margin="0,0,12,0" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="待办" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                    <TextBlock Text="{Binding TodoCount}" Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <!--③进行中卡片-->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Margin="0,0,12,0" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="进行中" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                    <TextBlock Text="{Binding InProgressCount}" Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <!--④已完成卡片-->
            <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="已完成" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                    <TextBlock Text="{Binding DoneCount}" Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--状态分布饼图-->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Margin="0,0,12,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="任务状态分布" Foreground="{DynamicResource TextPrimaryBrush}"
                                FontSize="16" FontWeight="Bold"/>
                    <!-- PieChart：Series 绑定到 VM 的 StatusSeries -->
                    <lvc:PieChart Grid.Row="1" Series="{Binding StatusSeries}"/>
                </Grid>
            </Border>
            
            <!--项目任务数柱状图-->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="项目任务数" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold"/>

                    <!-- CartesianChart：柱状图需要 Series + X/Y 轴 -->
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding ProjectSeries}"
                                        XAxes="{Binding ProjectXAxes}"
                                        YAxes="{Binding ProjectYAxes}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
