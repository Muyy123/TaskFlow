<Window x:Class="TaskFlow.Views.Dialogs.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建项目"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}">

    <StackPanel Margin="24">
        <!-- ①项目名称 -->
        <TextBlock Text="项目名称" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <!--
            UpdateSourceTrigger=PropertyChanged：每输入一个字符，立刻把值同步到ViewModel
            作用：实时触发CanSave校验，确定按钮灰态、错误提示马上更新
            MaxLength：限制最多输入100个字
        -->
        <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="100" Padding="6, 4"/>
        <!-- 名称为空的错误提示 -->
        <TextBlock Text="项目名称不能为空" Foreground="Red" FontSize="12" Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>  <!--默认隐藏-->
                    <Style.Triggers>
                        <!--当Name为空字符串时，显示报错文字-->
                        <DataTrigger Binding="{Binding Name}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- ②项目描述区域 -->
        <TextBlock Text="项目描述" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,4"/>
        <!--
            AcceptsReturn="True"：支持回车换行
            TextWrapping="Wrap"：文字自动换行
            高度固定60，内容超出时出现垂直滚动条
        -->
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="500" AcceptsReturn="True" Height="60"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6,4"/>
        
        <!-- ③项目颜色区域-->
        <TextBlock Text="项目颜色" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,4"/>
        <!--
            ListBox用来做单选色块选择
            ItemsSource绑定ViewModel里的PresetColors颜色列表
            SelectedItem双向绑定Color，选中色块自动更新ViewModel的Color属性
            去掉默认边框、背景，横向排列，不出现横向滚动条
        -->
        <ListBox ItemsSource="{Binding PresetColors}"
                 SelectedItem="{Binding Color, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- 默认ListBox是垂直排列，这里改成横向 -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!-- 每个色块项的样式：设置间距 -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="Padding" Value="2"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <!-- 每个颜色项的模板：渲染成圆角矩形色块 -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--色块：Fill绑定颜色字符串-->
                    <Rectangle Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
        </ListBox>
        <!-- ④底部按钮区域 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取消" Command="{Binding CancelCommand}" Padding="20,6" Margin="0,0,8,0"/>
            <Button Content="确认" Command="{Binding SaveCommand}" Padding="20,6"
                    Background="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </StackPanel>
</Window>
