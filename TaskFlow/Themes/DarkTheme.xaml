<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FF1E1E2E"/>  <!--顶部工具栏背景-->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF181825"/>  <!--左侧导航背景-->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FF2A2A36"/>  <!--内容区背景-->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2E2E3A"/>  <!--卡片/面板/表格底-->
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFE0E0E0"/>  <!--深色背景上的文字-->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE6E6E6"/>  <!--主文字-->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9A9A9A"/>  <!--次要文字-->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5BA0F5"/>  <!--分页控件的高亮色-->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3A46"/>  <!--边框/分割线-->
</ResourceDictionary>